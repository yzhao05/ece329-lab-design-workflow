{
  "schema_version": 1,
  "description": "Finite experiment-design pattern layer used to generate EMVR experiment methods after formula confirmation.",
  "patterns": [
    {
      "pattern_id": "FORWARD_VISUALIZATION",
      "title_zh": "正向现象展示",
      "design_logic": "给定条件，依据公式显示结果",
      "required_capabilities": ["可计算目标观察量", "可设置公式输入条件", "可视化计算结果"],
      "scene_requirements": {"must_have_known_parameters": true, "must_have_observation_display": true},
      "method_template": "建立满足适用条件的对象和初始参数，实时计算并显示{observed}；学生改变观察位置或视角，核对公式预测的空间分布。"
    },
    {
      "pattern_id": "SINGLE_PARAMETER_SWEEP",
      "title_zh": "单参数扫描",
      "design_logic": "固定其他条件，连续改变一个公式变量并记录响应",
      "required_capabilities": ["至少一个可连续调节变量", "可记录响应量", "可固定其余条件"],
      "scene_requirements": {"must_have_adjustable_parameter": true, "must_have_response_curve": true},
      "method_template": "固定其他条件，只连续改变{changed}，同步记录{observed}并生成响应曲线，用相同采样规则比较变化趋势。"
    },
    {
      "pattern_id": "CONTROLLED_COMPARISON",
      "title_zh": "多条件对照",
      "design_logic": "在公平控制下比较多个基础情况",
      "required_capabilities": ["至少两个可比较条件", "共享观察量", "可保持控制条件一致"],
      "scene_requirements": {"must_have_two_cases": true, "must_have_controlled_conditions": true},
      "method_template": "建立至少两个基础情形，仅切换{changed}，保持其余参数一致；并排记录{observed}，解释差异来自哪项条件。"
    },
    {
      "pattern_id": "COMPONENT_DECOMPOSITION",
      "title_zh": "分量拆解与合成",
      "design_logic": "先显示各项贡献，再显示合成结果",
      "required_capabilities": ["结果可拆成多个贡献", "可独立显示分量", "可计算合成结果"],
      "scene_requirements": {"must_have_component_toggle": true, "must_have_combined_display": true},
      "method_template": "分别开启各来源或各分量，显示它们对{observed}的独立贡献，再叠加显示总结果，并用颜色或矢量图区分各项。"
    },
    {
      "pattern_id": "SPATIAL_SEARCH",
      "title_zh": "空间搜索",
      "design_logic": "给定目标条件，在空间中寻找满足条件的位置",
      "required_capabilities": ["观察量具有空间分布", "可移动探针或观察点", "目标条件可判定"],
      "scene_requirements": {"must_have_measurement_tool": true, "must_have_success_condition": true},
      "method_template": "用可移动探针扫描空间，根据{observed}寻找满足目标条件的位置；系统只反馈测量结果和是否达标，不直接公布答案。"
    },
    {
      "pattern_id": "INVERSE_PARAMETER_INFERENCE",
      "title_zh": "反向参数推断",
      "design_logic": "给定观察结果，反推出公式参数",
      "required_capabilities": ["至少一个可隐藏参数", "观察结果与参数可辨识", "可重复测量"],
      "scene_requirements": {"must_have_unknown_parameter": true, "must_have_measurement_tool": true, "must_have_success_condition": true},
      "method_template": "隐藏{changed}中的一个参数，只开放探针测得的{observed}；学生用多次测量和公式反推未知值，最后揭示真值并计算误差。"
    },
    {
      "pattern_id": "PREDICT_OBSERVE_EXPLAIN",
      "title_zh": "预测—观察—解释",
      "design_logic": "操作前预测，操作后观察，最后解释差异",
      "required_capabilities": ["可在操作前记录预测", "可展示实际结果", "可比较预测与观察"],
      "scene_requirements": {"must_have_prediction_prompt": true, "must_have_post_observation_explanation": true},
      "method_template": "操作前让学生预测改变{changed}后{observed}如何变化；执行操作并显示结果，再要求用已确认公式解释预测与观察的一致或差异。"
    },
    {
      "pattern_id": "BOUNDARY_CONDITION_COMPARISON",
      "title_zh": "边界条件比较",
      "design_logic": "保持核心公式，改变适用边界并比较结果",
      "required_capabilities": ["至少一个可切换边界条件", "核心物理关系保持不变", "边界变化可观察"],
      "scene_requirements": {"must_have_boundary_toggle": true, "must_show_applicability": true},
      "method_template": "保持来源和核心公式不变，依次切换{boundary}，比较{observed}，并明确每种边界下公式的适用方式。"
    },
    {
      "pattern_id": "LIMIT_AND_APPROXIMATION_CHECK",
      "title_zh": "极限情况与近似检查",
      "design_logic": "改变尺度或比值，判断近似何时成立",
      "required_capabilities": ["存在可研究的极限参数", "有精确或数值结果作参照", "可定义近似误差"],
      "scene_requirements": {"must_have_scale_control": true, "must_have_error_indicator": true},
      "method_template": "把{changed}逐步推向近似成立和失效的两端，同时显示{observed}及近似误差，找出误差进入允许范围的条件。"
    },
    {
      "pattern_id": "MODEL_BREAKDOWN_COUNTEREXAMPLE",
      "title_zh": "模型失效与反例",
      "design_logic": "构造违反理想前提的情况，观察模型从何处失效",
      "required_capabilities": ["存在明确理想化前提", "可构造非理想情况", "可比较模型预测和实际显示"],
      "scene_requirements": {"must_have_ideal_model": true, "must_have_nonideal_case": true, "must_show_discrepancy": true},
      "method_template": "先在{boundary}下显示理想公式预测，再有控制地改变这一前提，定位{observed}开始明显偏离的区域，并说明偏离来自哪项假设失效。"
    },
    {
      "pattern_id": "TRANSIENT_PROCESS",
      "title_zh": "瞬态过程",
      "design_logic": "改变时间或输入波形，观察动态演化",
      "required_capabilities": ["公式描述时间演化", "可控制时间或输入波形", "可记录时序结果"],
      "scene_requirements": {"must_have_time_control": true, "must_have_timeline_or_curve": true},
      "method_template": "施加阶跃、脉冲或运动输入，控制时间推进，连续记录{observed}；可暂停、回放并标记关键瞬态时刻。"
    },
    {
      "pattern_id": "FREQUENCY_RESPONSE",
      "title_zh": "频率响应",
      "design_logic": "扫描频率并观察幅值、相位、衰减或共振",
      "required_capabilities": ["模型具有频率依赖", "频率可扫描", "可观察幅相或能量响应"],
      "scene_requirements": {"must_have_frequency_control": true, "must_have_amplitude_phase_display": true},
      "method_template": "在保持几何和材料不变时扫描频率，记录{observed}的幅值、相位、衰减或共振位置，并比较关键频段。"
    },
    {
      "pattern_id": "MEASUREMENT_METHOD_COMPARISON",
      "title_zh": "测量路径或观察方式比较",
      "design_logic": "物理系统不变，只改变测量与显示方式",
      "required_capabilities": ["至少两种观察方式", "共享同一物理状态", "结果可交叉验证"],
      "scene_requirements": {"must_have_multiple_views": true, "must_preserve_physical_state": true},
      "method_template": "保持系统状态不变，依次使用单点探针、路径扫描、截面图或三维显示观察{observed}，比较哪种方式最能回答研究问题。"
    },
    {
      "pattern_id": "DESIGN_OPTIMIZATION",
      "title_zh": "设计与优化任务",
      "design_logic": "给定目标结果，由学生调节参数实现目标",
      "required_capabilities": ["具有可调设计参数", "目标函数可计算", "可定义达标条件"],
      "scene_requirements": {"must_have_target_metric": true, "must_have_adjustable_parameters": true, "must_have_success_condition": true},
      "method_template": "给定关于{observed}的目标和容差，让学生调节{changed}；实时反馈目标函数但不直接给答案，达到条件后比较不同参数方案。"
    },
    {
      "pattern_id": "MULTI_SOLUTION_COMPARISON",
      "title_zh": "多方案比较",
      "design_logic": "比较两个可行实验设计的观察性、可控性和解释力",
      "required_capabilities": ["至少两个可行设计", "共享评价标准", "可保留设计差异"],
      "scene_requirements": {"must_have_two_designs": true, "must_have_evaluation_rubric": true},
      "method_template": "围绕同一公式形成两套实现，按现象明显程度、变量可控性、VR适配性、边界敏感性和公式解释力逐项比较后选择。"
    }
  ],
