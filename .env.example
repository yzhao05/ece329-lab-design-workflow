# Copy this file to .env.production and fill values only on the backend host.
OPENAI_API_KEY=
ECE329_GENERATOR=auto
OPENAI_MODEL=gpt-5.4-mini
# Public model dropdown allowlist. The active default model must be included. Enable only
# models your API project can use; labels/recommendation are supplied by backend.
ECE329_ALLOWED_MODELS=gpt-5.4-mini,gpt-5.4,gpt-5.4-nano,gpt-5.5,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,deepseek-flash,deepseek-flash:fast,deepseek-flash:reasoning,deepseek-v4-pro
# DeepSeek credentials stay on the backend. Missing provider keys hide its models.
# auto chooses OpenAI when available, otherwise DeepSeek; deepseek forces its default.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
# Includes reasoning tokens. Applied as a floor to per-stage output budgets.
DEEPSEEK_MAX_OUTPUT_TOKENS=8192
# Optional server-owned capability registry and stage-policy overrides (JSON).
ECE329_MODEL_REGISTRY=
ECE329_STAGE_POLICY=
# ECE329_MODEL_REGISTRY={"fast":{"model":"gpt-5.4-mini","reasoning":"low"},"balanced":{"model":"gpt-5.4-mini","reasoning":"medium"},"reasoning":{"model":"gpt-5.6-sol","reasoning":"high"}}
# ECE329_STAGE_POLICY={"THEORETICAL_FRAMEWORK":"reasoning","CONCEPTUAL_PROCEDURE":"balanced"}
# Trusted project partition for reviewed project-scoped experience.
ECE329_PROJECT_ID=ece329
OPENAI_REASONING_EFFORT=medium
# Includes both reasoning tokens and the structured intent JSON.
OPENAI_INTENT_MAX_OUTPUT_TOKENS=1400
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=2400
# Stage 1 needs extra room for several vivid, course-grounded exploration scenes.
OPENAI_STAGE_ONE_MAX_OUTPUT_TOKENS=3200
# Larger budget for the final EMVR design package only.
OPENAI_FINAL_MAX_OUTPUT_TOKENS=5000
ECE329_OPENAI_FALLBACK=true
# Recommended for the student-facing deployment: chain only formal replies
# with the response ID stored inside each individual design session.
# Intent classification remains stateless and the local design_state remains
# authoritative. The backend resends system instructions on every turn.
ECE329_OPENAI_STATEFUL=true

# Recommended for any public backend. Share this code out of band with students.
# The browser asks for it and keeps it only in sessionStorage; never commit a real value.
ECE329_ACCESS_CODE=

# Exact browser origin only: scheme + hostname, without a repository path.
ECE329_ALLOWED_ORIGINS=https://YOUR_GITHUB_USERNAME.github.io
ECE329_TRUST_PROXY=false
ECE329_RATE_LIMIT_REQUESTS=30
ECE329_RATE_LIMIT_WINDOW_SECONDS=60
ECE329_MAX_BODY_BYTES=65536
ECE329_MAX_TEXT_CHARS=4000

# Inactive design sessions are removed after this many days.
ECE329_SESSION_TTL_DAYS=30

# Keep the full prompt-packet route disabled in public deployments. If enabled
# temporarily for private debugging, use a separate strong token.
ECE329_ENABLE_PROMPT_DEBUG=false
ECE329_PROMPT_DEBUG_TOKEN=

# Separate maintainer credential for feedback-review.html. Never put this in
# docs/assets/config.js or share it with students. Empty disables review access.
ECE329_FEEDBACK_ADMIN_TOKEN=

# Keep this on a mounted persistent disk in production.
ECE329_DATABASE_PATH=/data/ece329.sqlite3
